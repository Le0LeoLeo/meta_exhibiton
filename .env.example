# Production startup rejects missing, placeholder, or shorter-than-32-character
# JWT secrets, and rejects missing, wildcard, or non-HTTPS origins.
NODE_ENV=production
PORT=5176
MULTIPLAYER_PORT=3001
REQUEST_BODY_LIMIT=1mb
GROWTH_UPLOAD_BODY_LIMIT=22mb
AI_REVIEW_BODY_LIMIT=50mb

# Use memory for one Node process. Use redis for two or more processes.
INSTANCE_COUNT=1
MULTIPLAYER_SHARED_STATE=memory
MULTIPLAYER_SCENE_TTL_SECONDS=3600
REDIS_URL=

# Generate a unique random value with at least 32 characters.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
FRONTEND_ORIGIN=https://example.com
MULTIPLAYER_CORS_ORIGIN=https://example.com

# Optional. Leave empty to disable administrator access.
# To enable it, generate a separate unique random value with at least 32 characters.
ADMIN_SECRET=replace-with-a-unique-random-admin-secret-at-least-32-characters

QWEN_API_KEY=
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-plus
QWEN_TIMEOUT_MS=15000

QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_TIMEOUT_MS=30000
