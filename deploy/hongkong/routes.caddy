encode zstd gzip
header {
	X-Content-Type-Options nosniff
	Referrer-Policy strict-origin-when-cross-origin
	X-Frame-Options DENY
	Permissions-Policy "camera=(), geolocation=(), microphone=()"
}

@multiplayer path /socket.io /socket.io/*
handle @multiplayer {
	reverse_proxy app:3001
}
@backend path /api /api/* /uploads /uploads/*
handle @backend {
	# Private uploads are authorized by Express, never served as static files.
	header Cache-Control "no-store"
	reverse_proxy app:5176
}
@exhibitionPage path_regexp exhibitionPage ^/exhibitions/[^/]+/?$
handle @exhibitionPage {
	reverse_proxy app:5176
}
@indexDocument path /index.html
redir @indexDocument / permanent
@homepage path /
handle @homepage {
	root * /srv
	rewrite * /home.html
	header Cache-Control "no-cache"
	file_server
}
handle {
	root * /srv
	try_files {path} /index.html
	file_server
}
